# Supabase — https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Upstage Solar Pro — https://console.upstage.ai
UPSTAGE_API_KEY=

# 공공데이터포털 (data.go.kr) — 기업마당 bizinfo API key. Use the *decoded* key (== not %3D%3D)
BIZINFO_API_KEY=

# bizinfo.go.kr — 기업마당 행사정보 API (전시회/세미나/설명회/교육 등), a sibling
# of BIZINFO_API_KEY above but its own separate key issuance.
# Apply at https://www.bizinfo.go.kr/apiDetail.do?id=bizinfoEventApi
BIZINFO_EVENT_API_KEY=

# bizno.net free 사업자등록번호 상태조회 API (200 req/day) — see lib/verification/business.ts.
# Note the name: this is BIZNO (사업자조회), not BIZINFO (기업마당) above — easy to
# mix up. Sign up at https://bizno.net and generate a free key from 마이페이지.
BIZNO_API_KEY=

# 토스페이먼츠 — https://developers.tosspayments.com
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# Resend (email) — https://resend.com/api-keys
RESEND_API_KEY=

# Canonical service origin used for absolute links in notification emails.
NEXT_PUBLIC_APP_URL=https://eunwon.com

# Where /contact form submissions are emailed. Defaults to daniel@eunwon.com if unset.
CONTACT_EMAIL_TO=

# Cron security — any random string; also set the same value in Vercel's
# project environment variables so Vercel Cron sends it automatically.
CRON_SECRET=
